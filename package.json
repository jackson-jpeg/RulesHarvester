{
  "name": "rulesharvester",
  "version": "2.0.0",
  "private": true,
  "description": "AI-powered legal rule extraction system using Claude",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w @rulesharvester/client",
    "dev:server": "npm run dev -w @rulesharvester/server",
    "build": "npm run build -w @rulesharvester/shared && npm run build -w @rulesharvester/server && npm run build -w @rulesharvester/client",
    "build:shared": "npm run build -w @rulesharvester/shared",
    "build:server": "npm run build -w @rulesharvester/server",
    "build:client": "npm run build -w @rulesharvester/client",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "start:prod": "node packages/server/dist/index.js",
    "build:prod": "npm run build:shared && npm run build:server && npm run db:generate",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
